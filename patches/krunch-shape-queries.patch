+namespace Krunch {
+    std::optional<ShapeCastResult> PhysicsWorld::shapeCast(
+        const Eigen::Vector3d &start, const Eigen::Quaterniond &rotation,
+        const Eigen::Vector3d &halfExtents, bool sphere,
+        const Eigen::Vector3d &direction, double distance,
+        const std::vector<RigidBodyId> &ignoredBodies
+    ) {
+        if (!start.allFinite() || !rotation.coeffs().allFinite() ||
+            std::abs(rotation.norm() - 1.0) > 1e-5 || !halfExtents.allFinite() ||
+            halfExtents.minCoeff() <= 0.0 || halfExtents.maxCoeff() > 1e6 ||
+            !direction.allFinite() || std::abs(direction.norm() - 1.0) > 1e-5 ||
+            !std::isfinite(distance) || distance < 0.0 || distance > 1e6) {
+            throw std::invalid_argument("Invalid shape cast geometry or motion");
+        }
+        using namespace physx;
+        const auto toPx = [](const Vector3r &v) {
+            return PxVec3(static_cast<float>(v.x()), static_cast<float>(v.y()), static_cast<float>(v.z()));
+        };
+        const auto fromPx = [](const PxVec3 &v) { return Vector3r(v.x, v.y, v.z); };
+        const auto toQuat = [](const Quaternionr &q) {
+            return PxQuat(static_cast<float>(q.x()), static_cast<float>(q.y()),
+                          static_cast<float>(q.z()), static_cast<float>(q.w()));
+        };
+        const Vector3r worldExtent = sphere ? Vector3r::Constant(halfExtents.x()).eval()
+            : (rotation.toRotationMatrix().cwiseAbs() * halfExtents).eval();
+        AlignedBox3r worldBounds(start.cwiseMin(start + direction * distance) - worldExtent,
+                               start.cwiseMax(start + direction * distance) + worldExtent);
+        std::optional<ShapeCastResult> result;
+        double bestDistance = distance;
+        for (auto &entry : rigidBodiesAndIds) {
+            if (!entry.getIsValid() || !entry.rigidBody.hasCollisionSegments() ||
+                std::find(ignoredBodies.begin(), ignoredBodies.end(), entry.rigidBodyId) != ignoredBodies.end()) continue;
+            auto &body = entry.rigidBody;
+            forEachCollisionSegmentView(body, [&](const CollisionSegmentView &view) {
+                if (!view.segment || view.segment->isNullSegment()) return;
+                AlignedBox3r bounds;
+                const bool bounded = view.instance ? body.getAABB(bounds, *view.instance) : body.getAABB(bounds, *view.segment);
+                if (bounded && !bounds.isEmpty() && !bounds.intersects(worldBounds)) return;
+                const auto segmentPose = getSegmentCollisionPoseVel(body, view).getPose();
+                const auto displacement = getSegmentCollisionDisplacement(body, view);
+                const Vector3r localStart = segmentPose.invTransform(start);
+                const Vector3r localDirection = segmentPose.invRotate(direction);
+                const Quaternionr localRotation = segmentPose.getRot().conjugate() * rotation;
+                PxGeometryHolder query;
+                if (sphere) query.storeAny(PxSphereGeometry(static_cast<float>(halfExtents.x())));
+                else query.storeAny(PxBoxGeometry(toPx(halfExtents)));
+                const PxTransform queryPose(PxVec3(0), toQuat(localRotation));
+                auto save = [&](double travel, const Vector3r &localPoint, const Vector3r &localNormal,
+                                double frictionStatic, double frictionDynamic, double restitution,
+                                bool overlap, bool supported) {
+                    if (travel > bestDistance) return;
+                    const Vector3r point = segmentPose.transform(localPoint);
+                    const Vector3r velocity = body.getPoseVel().getVelocityFromLocalPos(
+                        body.getPoseVel().getPose().invTransform(point)) +
+                        getSegmentSurfaceVelocityInGlobal(body, view, localPoint);
+                    result = ShapeCastResult{entry.rigidBodyId, view.segmentId, travel, point,
+                        segmentPose.rotate(localNormal).normalized(), velocity,
+                        body.getPoseVel().getOmega() + getSegmentLocalAngularVelocityInGlobal(body, view),
+                        frictionStatic, frictionDynamic, restitution, overlap, supported};
+                    bestDistance = travel;
+                };
+                auto cast = [&](const PxGeometry &target, const Vector3r &center, const Quaternionr &orientation,
+                                double frictionStatic, double frictionDynamic, double restitution) {
+                    const PxTransform targetPose(toPx(center - localStart), toQuat(orientation));
+                    PxVec3 separation;
+                    PxReal depth = 0;
+                    const bool overlap = PxGeometryQuery::computePenetration(separation, depth,
+                        query.any(), queryPose, target, targetPose) && depth > 1e-6f;
+                    if (overlap) {
+                        const Vector3r n = fromPx(separation);
+                        const Vector3r support = sphere ? (n * halfExtents.x()).eval()
+                            : (localRotation * ((localRotation.conjugate() * n).array().sign().matrix().cwiseProduct(halfExtents))).eval();
+                        save(0, localStart - support + n * depth, n, frictionStatic, frictionDynamic, restitution, true, true);
+                        return;
+                    }
+                    if (distance == 0) return;
+                    PxSweepHit hit;
+                    if (PxGeometryQuery::sweep(toPx(localDirection), static_cast<float>(bestDistance),
+                        query.any(), queryPose, target, targetPose, hit, PxHitFlag::eDEFAULT | PxHitFlag::ePRECISE_SWEEP)) {
+                        if (hit.normal.magnitudeSquared() < 0.5f) return;
+                        save(std::max(0.0, static_cast<double>(hit.distance)), localStart + fromPx(hit.position),
+                             fromPx(hit.normal), frictionStatic, frictionDynamic, restitution, false, true);
+                    }
+                };
+                const auto unsupported = [&] {
+                    save(0, localStart, -localDirection, body.staticFrictionCoefficient,
+                         body.dynamicFrictionCoefficient, body.collisionRestitutionCoefficient, false, false);
+                };
+                const Real scale = displacement.getShapeScaling();
+                if (!std::isfinite(scale) || std::abs(scale) < 1e-12) { unsupported(); return; }
+                if (view.segment->isVoxelLodShape()) {
+                    const auto manager = view.segment->getVoxelLodManagerConst();
+                    if (!manager) { unsupported(); return; }
+                    const Vector3r offset = manager->getOffset() + displacement.getShapeOffset();
+                    const Vector3r extent = sphere ? Vector3r::Constant(halfExtents.x()).eval()
+                        : (localRotation.toRotationMatrix().cwiseAbs() * halfExtents).eval();
+                    const Vector3r a = (localStart.cwiseMin(localStart + localDirection * bestDistance) - extent) / scale - offset;
+                    const Vector3r b = (localStart.cwiseMax(localStart + localDirection * bestDistance) + extent) / scale - offset;
+                    std::vector<VoxelColliderBlock> blocks;
+                    manager->getSolidVoxelColliderShape().getSolidBlocksIntersectingLocalBounds(
+                        AlignedBox3r(a.cwiseMin(b), a.cwiseMax(b)), blocks);
+                    const auto &registry = manager->getVoxelStateVoxelWorld().getBlockRegistry();
+                    for (const auto &block : blocks) {
+                        const auto &state = registry.getLod1SolidBlockState(block.blockStateId);
+                        const auto *boxes = std::get_if<Lod1SolidBoxesCollisionShape>(&state.getLod1SolidCollisionShape());
+                        if (!boxes) { unsupported(); continue; }
+                        for (uint8_t i = 0; i < boxes->getSolidBoxesCount(); ++i) {
+                            const auto box = boxes->getSolidBoxes()[i].getBox();
+                            const Vector3r center = (box.center().cast<Real>() - Vector3r::Constant(0.5) +
+                                block.blockPos.cast<Real>() + offset) * scale;
+                            const Vector3r extentBox = box.sizes().cast<Real>() * (std::abs(scale) * 0.5);
+                            cast(PxBoxGeometry(toPx(extentBox)), center, Quaternionr::Identity(),
+                                 state.getFriction(), state.getFriction(), state.getElasticity());
+                        }
+                    }
+                    return;
+                }
+                const auto &shape = view.segment->getCollisionShapeConst();
+                if (!shape) { unsupported(); return; }
+                PxGeometryHolder target;
+                Quaternionr targetRotation = Quaternionr::Identity();
+                const auto magnitude = static_cast<float>(std::abs(scale));
+                switch (shape->getShapeType()) {
+                    case ShapeType::BOX: {
+                        const auto &box = static_cast<const BoxShape &>(*shape);
+                        target.storeAny(PxBoxGeometry(static_cast<float>(box.xLen) * magnitude,
+                            static_cast<float>(box.yLen) * magnitude, static_cast<float>(box.zLen) * magnitude));
+                        break;
+                    }
+                    case ShapeType::SPHERE:
+                        target.storeAny(PxSphereGeometry(static_cast<float>(static_cast<const SphereShape &>(*shape).getRadius()) * magnitude));
+                        break;
+                    case ShapeType::CAPSULE: {
+                        const auto &capsule = static_cast<const CapsuleShape &>(*shape);
+                        target.storeAny(PxCapsuleGeometry(static_cast<float>(capsule.getRadius()) * magnitude,
+                            static_cast<float>(capsule.getHalfLength()) * magnitude));
+                        break;
+                    }
+                    case ShapeType::PLANE:
+                        target.storeAny(PxPlaneGeometry());
+                        if (scale < 0) targetRotation = Eigen::AngleAxis<Real>(std::acos(-1.0), Vector3r::UnitY());
+                        break;
+                    default: unsupported(); return;
+                }
+                cast(target.any(), displacement.transformPos(Vector3r::Zero()), targetRotation,
+                     body.staticFrictionCoefficient, body.dynamicFrictionCoefficient, body.collisionRestitutionCoefficient);
+            });
+        }
+        return result;
+    }
+}
