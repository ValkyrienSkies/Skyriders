diff --git a/KrunchJni/org_valkyrienskies_physics_api_krunch_KrunchNativePhysicsWorldReference.cpp b/KrunchJni/org_valkyrienskies_physics_api_krunch_KrunchNativePhysicsWorldReference.cpp
index d91f1f61..78373f96 100644
--- a/KrunchJni/org_valkyrienskies_physics_api_krunch_KrunchNativePhysicsWorldReference.cpp
+++ b/KrunchJni/org_valkyrienskies_physics_api_krunch_KrunchNativePhysicsWorldReference.cpp
@@ -1162,3 +1162,31 @@ JNIEXPORT jbyteArray JNICALL Java_org_valkyrienskies_physics_1api_1krunch_Krunch
     }
     return krunchByteBufToJavaByteArray(env, byteBuf);
 }
+
+extern "C" JNIEXPORT jbyteArray JNICALL Java_org_valkyrienskies_physics_1api_1krunch_KrunchNativePhysicsWorldReference_shapeCastNative
+(JNIEnv *env, jclass, jlong pointer, jdouble x, jdouble y, jdouble z,
+ jdouble qx, jdouble qy, jdouble qz, jdouble qw, jdouble hx, jdouble hy, jdouble hz,
+ jboolean sphere, jdouble dx, jdouble dy, jdouble dz, jdouble distance, jintArray ignored) {
+    const auto owner = pinPhysicsWorld(env, pointer);
+    if (!owner) return nullptr;
+    try {
+        const auto hit = owner->shapeCast({x, y, z}, {qw, qx, qy, qz}, {hx, hy, hz}, sphere,
+                                         {dx, dy, dz}, distance, jintArrayToVector(env, ignored));
+        if (!hit) return nullptr;
+        Krunch::krunch_byte_buf bytes;
+        bytes.putInt(hit->hitBodyId);
+        bytes.putUInt(static_cast<uint32_t>(hit->segmentId));
+        bytes.putUInt(static_cast<uint32_t>(static_cast<uint64_t>(hit->segmentId) >> 32));
+        bytes.putDouble(hit->distance);
+        Krunch::constraint_encoder::writeVector3d(hit->point, bytes);
+        Krunch::constraint_encoder::writeVector3d(hit->normal, bytes);
+        Krunch::constraint_encoder::writeVector3d(hit->velocity, bytes);
+        Krunch::constraint_encoder::writeVector3d(hit->angularVelocity, bytes);
+        bytes.putDouble(hit->staticFriction);
+        bytes.putDouble(hit->dynamicFriction);
+        bytes.putDouble(hit->restitution);
+        bytes.putByte(hit->initialOverlap);
+        bytes.putByte(hit->geometrySupported);
+        return krunchByteBufToJavaByteArray(env, bytes);
+    } catch (const std::exception &error) { throwIllegalArgumentException(env, error.what()); return nullptr; }
+}
