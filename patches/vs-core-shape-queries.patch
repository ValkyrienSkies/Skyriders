+package org.valkyrienskies.core.api.physics
+
+import org.joml.Vector3dc
+import org.valkyrienskies.core.api.bodies.PhysVsBody
+import org.valkyrienskies.core.api.util.PhysTickOnly
+
+/** Fixed-orientation sweep result. Distance measures center travel, including zero for initial overlap.
+ * Unsupported geometry conservatively blocks the query; its point and normal are not a surface contact.
+ */
+@PhysTickOnly
+data class ShapeCastResult(
+    val hitBody: PhysVsBody,
+    val segmentId: Long,
+    val distance: Double,
+    val point: Vector3dc,
+    val normal: Vector3dc,
+    val velocity: Vector3dc,
+    val angularVelocity: Vector3dc,
+    val staticFriction: Double,
+    val dynamicFriction: Double,
+    val restitution: Double,
+    val initialOverlap: Boolean,
+    val geometrySupported: Boolean,
+)
