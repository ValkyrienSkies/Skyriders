@@ -0,0 +1,21 @@
+package org.valkyrienskies.physics_api
+
+import org.joml.Vector3dc
+
+/** Distance is center travel; point, normal and point velocity are in world coordinates.
+ * Unsupported geometry is a conservative blocker, never a clear result.
+ */
+data class ShapeCastResult(
+    val hitBodyId: PhysicsBodyId,
+    val segmentId: Long,
+    val distance: Double,
+    val point: Vector3dc,
+    val normal: Vector3dc,
+    val velocity: Vector3dc,
+    val angularVelocity: Vector3dc,
+    val staticFriction: Double,
+    val dynamicFriction: Double,
+    val restitution: Double,
+    val initialOverlap: Boolean,
+    val geometrySupported: Boolean,
+)
