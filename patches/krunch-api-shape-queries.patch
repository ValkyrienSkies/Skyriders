+package org.valkyrienskies.physics_api_krunch
+
+import org.joml.Quaterniond
+import org.joml.Vector3d
+import org.joml.Vector3i
+import org.joml.primitives.AABBi
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.valkyrienskies.physics_api.PoseVel
+import org.valkyrienskies.physics_api_krunch.KrunchTestUtils.assertVecNearlyEquals
+import org.valkyrienskies.physics_api_krunch.KrunchTestUtils.createTestPhysicsWorld
+import org.valkyrienskies.physics_api_krunch.factories.VSKrunchPhysicsFactories
+
+class ShapeCastTest {
+    @Test
+    fun sphereAndBoxReportSurfaceAndInitialOverlap() {
+        KrunchBootstrap.loadNativeBinaries()
+        val world = createTestPhysicsWorld()
+        val shape = KrunchCollisionShapeFactory().makeBoxShapeReference(Vector3d(2.0))
+        try {
+            val body = world.createRigidBody(shape)
+            body.isStatic = true
+            val hit = requireNotNull(world.sweepSphere(Vector3d(0.0, 4.0, 0.0), 0.5, Vector3d(0.0, -1.0, 0.0), 10.0))
+            assertEquals(2.5, hit.distance, 1e-5)
+            assertVecNearlyEquals(Vector3d(0.0, 1.0, 0.0), hit.point, 1e-5)
+            assertVecNearlyEquals(Vector3d(0.0, 1.0, 0.0), hit.normal, 1e-5)
+            assertFalse(hit.initialOverlap)
+            assertTrue(hit.geometrySupported)
+            val box = requireNotNull(world.sweepBox(Vector3d(0.0, 4.0, 0.0), Quaterniond(), Vector3d(0.25, 0.5, 0.25),
+                Vector3d(0.0, -1.0, 0.0), 10.0))
+            assertEquals(hit.distance, box.distance, 1e-5)
+            val embedded = requireNotNull(world.sweepSphere(Vector3d(0.0, 1.1, 0.0), 0.5, Vector3d(0.0, -1.0, 0.0), 0.0))
+            assertTrue(embedded.initialOverlap)
+            assertEquals(0.0, embedded.distance)
+            assertNull(world.sweepSphere(Vector3d(0.0, 4.0, 0.0), 0.5, Vector3d(0.0, -1.0, 0.0), 10.0, body.physicsBodyId))
+            assertThrows(IllegalArgumentException::class.java) {
+                world.sweepSphere(Vector3d(), Double.NaN, Vector3d(0.0, -1.0, 0.0), 1.0)
+            }
+        } finally { world.deletePhysicsWorldResources(); shape.close() }
+    }
+
+    @Test
+    fun transformedSegmentPreservesIdentityPointVelocityAndLargeCoordinates() {
+        KrunchBootstrap.loadNativeBinaries()
+        val world = createTestPhysicsWorld()
+        val factory = KrunchCollisionShapeFactory()
+        val box = factory.makeBoxShapeReference(Vector3d(2.0))
+        val compound = factory.makeCompoundShapeReference()
+        try {
+            compound.makeNewSegment(37, box, PoseVel.createPoseVel(Vector3d(3.0, 0.0, 0.0), Quaterniond()), 2.0, Vector3d())
+            val body = world.createRigidBody(compound)
+            val origin = Vector3d(30_000_000.0, 20.0, -30_000_000.0)
+            val rotation = Quaterniond().rotateZ(Math.PI / 2)
+            body.poseVel = PoseVel.createPoseVel(origin, rotation).copy(vel = Vector3d(7.0, 0.0, 0.0), omega = Vector3d(0.0, 0.0, 2.0))
+            val center = rotation.transform(Vector3d(3.0, 0.0, 0.0)).add(origin)
+            val hit = requireNotNull(world.sweepSphere(Vector3d(center).add(0.0, 5.0, 0.0), 0.5,
+                Vector3d(0.0, -1.0, 0.0), 10.0))
+            assertEquals(37L, hit.segmentId)
+            assertEquals(2.5, hit.distance, 1e-5)
+            assertVecNearlyEquals(Vector3d(center).add(0.0, 2.0, 0.0), hit.point, 1e-5)
+            val expectedVelocity = Vector3d(0.0, 0.0, 2.0).cross(Vector3d(hit.point).sub(origin)).add(7.0, 0.0, 0.0)
+            assertVecNearlyEquals(expectedVelocity, hit.velocity, 1e-5)
+        } finally { world.deletePhysicsWorldResources(); compound.close(); box.close() }
+    }
+
+    @Test
+    fun voxelSlabUsesItsSubBoxAndEmptyHalfRemainsClear() {
+        KrunchBootstrap.loadNativeBinaries()
+        val world = createTestPhysicsWorld()
+        val registry = TestLod1Blocks.generateBasicLod1Registry()
+        val buffer = VSKrunchPhysicsFactories.vsByteBufferFactory.createVSByteBuffer(65536)
+        val shape = KrunchCollisionShapeFactory().makeVoxelShapeReference(Vector3i(0), Vector3i(15), AABBi(0, 0, 0, 15, 15, 15), registry)
+        try {
+            KrunchTestUtils.setBlock(shape, Vector3i(2, 2, 2), TestLod1Blocks.BOTTOM_SLAB_STATE, registry, buffer)
+            shape.bakeVoxelShape()
+            world.createRigidBody(shape).isStatic = true
+            val hit = requireNotNull(world.sweepSphere(Vector3d(2.0, 4.0, 2.0), 0.25, Vector3d(0.0, -1.0, 0.0), 4.0))
+            assertEquals(1.75, hit.distance, 1e-5)
+            assertEquals(2.0, hit.point.y(), 1e-5)
+            assertNull(world.sweepBox(Vector3d(0.0, 2.3, 2.0), Quaterniond(), Vector3d(0.1), Vector3d(1.0, 0.0, 0.0), 4.0))
+        } finally { world.deletePhysicsWorldResources(); shape.close(); registry.close() }
+    }
+}
