+package org.valkyrienskies.physics_api_krunch.raycast
+
+import org.valkyrienskies.physics_api.ShapeCastResult
+import org.valkyrienskies.physics_api_krunch.ConstraintEncoder
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+object ShapeCastResultDecoder {
+    @JvmStatic
+    fun decode(bytes: ByteArray): ShapeCastResult {
+        require(bytes.size == 142) { "Invalid shape cast result size ${bytes.size}" }
+        val buffer = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN)
+        return ShapeCastResult(buffer.int, buffer.long, buffer.double,
+            ConstraintEncoder.readVector3dc(buffer), ConstraintEncoder.readVector3dc(buffer),
+            ConstraintEncoder.readVector3dc(buffer), ConstraintEncoder.readVector3dc(buffer),
+            buffer.double, buffer.double, buffer.double, buffer.get().toInt() != 0, buffer.get().toInt() != 0)
+    }
+}
